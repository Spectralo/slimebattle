[sub_resource type="GDScript" id="GDScript_3q24r"]
script/source = "extends Control

var PORT = 3333
var SERVER_NAME = \"\"

func _on_launch_pressed():
	pass
	
func _process(delta):
	var num = $MarginContainer/VBoxContainer/MarginContainer/HBoxContainer/MarginContainer/LineEdit.text
	PORT = int(num)
	var text = $MarginContainer/VBoxContainer/MarginContainer4/HBoxContainer/MarginContainer/Name.text
	SERVER_NAME = text
"

[sub_resource type="GDScript" id="GDScript_y0nsq"]
script/source = "extends Control

var PORT = 3333

func join_game(address = \"\"):
	if address.is_empty():
		return
	var peer = ENetMultiplayerPeer.new()
	var error = peer.create_client(address, PORT)
	if error:
		return error
	multiplayer.multiplayer_peer = peer
"

